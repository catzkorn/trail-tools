{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@components/*": ["./components/*"],
      "gen/*": ["./gen/*"],
      "helpers/*": ["./helpers/*"],
      "pages/*": ["./pages/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
